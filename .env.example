# Local-only AI inference through Ollama. No cloud provider key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_TIMEOUT_MS=300000
OLLAMA_EMBEDDING_TIMEOUT_MS=300000

# Local SQLite database and private uploaded documents are stored under ./data.
# The runtime migrates existing SQLite databases without deleting chunks or pages.
